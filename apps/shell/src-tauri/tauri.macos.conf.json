{
	"$schema": "https://schema.tauri.app/config/2",
	"identifier": "app.q2q.anvil",
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Anvil",
				"url": "anvil-app://localhost/",
				"width": 900,
				"height": 620,
        "minWidth": 620,
        "minHeight": 420,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"transparent": true,
				"windowEffects": {
					"effects": [
						"liquidGlassRegular",
						"underWindowBackground"
					],
					"state": "followsWindowActiveState"
				}
			}
		]
	}
}
