{
	"$schema": "https://schema.tauri.app/config/2",
	"identifier": "app.q2q.anvil.dev",
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Anvil",
				"url": "index.html",
				"width": 900,
				"height": 620,
				"minWidth": 900,
				"minHeight": 620,
				"titleBarStyle": "Overlay",
				"trafficLightPosition": {
					"x": 12,
					"y": 19
				},
				"hiddenTitle": true,
				"transparent": true,
				"windowEffects": {
					"effects": [
						"liquidGlassRegular",
						"underWindowBackground"
					],
					"state": "followsWindowActiveState"
				}
			}
		]
	}
}
