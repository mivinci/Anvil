{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anvil",
  "version": "0.1.0",
  "identifier": "com.mivinci.anvil",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @anvil/desktop",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --workspace @anvil/desktop",
    "frontendDist": "../../desktop/build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Anvil",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
